{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1240px"
		},
		"color": {
			"defaultPalette": false,
			"palette": [
				{ "slug": "ink", "name": "Midnight Navy", "color": "#071A2B" },
				{ "slug": "steel", "name": "Deep Navy", "color": "#0C1E2C" },
				{ "slug": "signal", "name": "Antique Bronze", "color": "#8F7A4E" },
				{ "slug": "ice", "name": "Ivory", "color": "#F3F1EC" },
				{ "slug": "silver", "name": "Cufflink Silver", "color": "#B8C4CC" },
				{ "slug": "brass", "name": "Brass", "color": "#D2A84A" },
				{ "slug": "paper", "name": "Paper", "color": "#FCFCFA" },
				{ "slug": "white", "name": "White", "color": "#FFFFFF" }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "vw", "%" ],
			"spacingSizes": [
				{ "slug": "20", "name": "2XS", "size": "0.5rem" },
				{ "slug": "30", "name": "XS", "size": "0.75rem" },
				{ "slug": "40", "name": "S", "size": "1rem" },
				{ "slug": "50", "name": "M", "size": "1.5rem" },
				{ "slug": "60", "name": "L", "size": "2.5rem" },
				{ "slug": "70", "name": "XL", "size": "4rem" },
				{ "slug": "80", "name": "2XL", "size": "6rem" }
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display Serif",
					"fontFamily": "\"Iowan Old Style\", \"Palatino Linotype\", Georgia, serif"
				},
				{
					"slug": "body",
					"name": "Body Sans",
					"fontFamily": "Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.05rem" },
				{ "slug": "large", "name": "Large", "size": "clamp(1.2rem, 2vw, 1.5rem)" },
				{ "slug": "x-large", "name": "Extra Large", "size": "clamp(2rem, 4vw, 3.5rem)" },
				{ "slug": "hero", "name": "Hero", "size": "clamp(2.35rem, 4.2vw, 3.75rem)" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|paper",
			"text": "var:preset|color|ink"
		},
		"spacing": {
			"blockGap": "1.5rem"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.65"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontWeight": "500",
					"lineHeight": "1.05"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|brass",
					"text": "var:preset|color|ink"
				},
				"border": {
					"radius": "2px"
				},
				"spacing": {
					"padding": {
						"top": "0.85rem",
						"right": "1.35rem",
						"bottom": "0.85rem",
						"left": "1.35rem"
					}
				},
				"typography": {
					"fontSize": "0.875rem",
					"fontWeight": "700",
					"letterSpacing": "0.075em",
					"textTransform": "uppercase"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|ink"
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
